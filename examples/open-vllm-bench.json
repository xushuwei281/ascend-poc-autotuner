{
  "schema_version": 1,
  "name": "Open tuning with vLLM benchmark CLI — real model inference on random inputs",
  "hardware": {
    "device_type": "Ascend 910B A2",
    "device_count": 2,
    "devices": [
      "0",
      "1"
    ]
  },
  "models": [
    {
      "id": "customer-model-bf16",
      "path": "{env:MODEL_PATH}",
      "family": "CUSTOMER_MODEL",
      "precision": "bf16"
    }
  ],
  "server": {
    "command": [
      "vllm",
      "serve",
      "{model}"
    ],
    "fixed_options": {
      "host": "127.0.0.1",
      "port": 8000,
      "served-model-name": "poc-model"
    },
    "env": {
      "ASCEND_RT_VISIBLE_DEVICES": "0,1"
    },
    "health_url": "http://127.0.0.1:8000/health",
    "startup_timeout_s": 900,
    "shutdown_timeout_s": 20
  },
  "discovery": {
    "command": [
      "vllm",
      "serve",
      "--help=all"
    ],
    "timeout_s": 60,
    "env_names": []
  },
  "baseline": {
    "model": "customer-model-bf16",
    "engine": {
      "tensor-parallel-size": 2,
      "max-num-seqs": 32,
      "max-num-batched-tokens": 4096,
      "gpu-memory-utilization": 0.85,
      "max-model-len": 8192
    },
    "env": {},
    "workload": {
      "concurrency": 32,
      "input_tokens": 4096,
      "output_tokens": 512,
      "num_prompts": 1000
    }
  },
  "workload_parameters": {
    "concurrency": {
      "type": "integer",
      "minimum": 1,
      "description": "Client load offered to the service; free unless the request fixes it."
    },
    "input_tokens": {
      "type": "integer",
      "minimum": 1,
      "description": "Synthetic request input length; changing it changes the reported workload."
    },
    "output_tokens": {
      "type": "integer",
      "minimum": 1,
      "description": "Synthetic output length; changing it changes the reported workload."
    },
    "num_prompts": {
      "type": "integer",
      "minimum": 1,
      "description": "Measured request count. Report sample size; small runs have uncertain tail percentiles."
    }
  },
  "scenarios": [
    {
      "name": "random_inference_load",
      "command": [
        "vllm",
        "bench",
        "serve",
        "--model",
        "poc-model",
        "--served-model-name",
        "poc-model",
        "--base-url",
        "http://127.0.0.1:8000",
        "--backend",
        "vllm",
        "--endpoint",
        "/v1/completions",
        "--dataset-name",
        "random",
        "--random-input-len",
        "{workload.input_tokens}",
        "--random-output-len",
        "{workload.output_tokens}",
        "--random-range-ratio",
        "0",
        "--ignore-eos",
        "--num-prompts",
        "{workload.num_prompts}",
        "--num-warmups",
        "20",
        "--request-rate",
        "inf",
        "--max-concurrency",
        "{workload.concurrency}",
        "--seed",
        "42",
        "--percentile-metrics",
        "ttft,tpot,itl,e2el",
        "--metric-percentiles",
        "50,95,99",
        "--save-result",
        "--result-dir",
        "{trial_dir}",
        "--result-filename",
        "metrics.json",
        "--tokenizer",
        "{env:BENCHMARK_TOKENIZER_PATH}"
      ],
      "result_file": "{trial_dir}/metrics.json",
      "metrics_format": "vllm",
      "timeout_s": 900
    }
  ],
  "metric_names": [
    "output_tokens_per_second",
    "request_per_second",
    "total_tokens_per_second",
    "p99_ttft_ms",
    "p99_tpot_ms",
    "p99_itl_ms",
    "p99_e2el_ms",
    "completed"
  ],
  "benchmark_env": {},
  "llm": {
    "base_url": "https://YOUR_PROVIDER_HOST/v1",
    "model": "YOUR_PROVIDER_MODEL_ID",
    "api_key_env": "POC_LLM_API_KEY",
    "timeout_s": 60,
    "max_tokens": 4000,
    "temperature": 0.2,
    "json_mode": true,
    "max_retries": 0
  },
  "research": {
    "endpoint": "https://mcp.deepwiki.com/mcp",
    "repository": "vllm-project/vllm-ascend",
    "timeout_s": 60,
    "max_calls": 12,
    "on_error": "stop"
  },
  "budget": {
    "max_experiments": 12,
    "max_wall_time_s": 14400,
    "max_llm_calls": 32,
    "repetitions": 1,
    "final_repetitions": 3
  },
  "verification": {
    "mode": "aba",
    "max_baseline_drift": 0.05,
    "min_relative_improvement": 0.02,
    "drift_multiplier": 2.0,
    "frozen_files": []
  }
}
